@page "{id:int}"
@model GestionProduits.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Supprimer la catégorie"; }

<h1>Supprimer cette catégorie ?</h1>

@if (Model.Erreur != null)
{
    <div class="alert alert-danger">@Model.Erreur</div>
}

<dl class="row">
    <dt class="col-sm-2">Nom</dt>
    <dd class="col-sm-10">@Model.Categorie.Nom</dd>
    <dt class="col-sm-2">Produits</dt>
    <dd class="col-sm-10">@Model.Categorie.Produits.Count</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
    <a href="/Categories" class="btn btn-secondary">Annuler</a>
</form>